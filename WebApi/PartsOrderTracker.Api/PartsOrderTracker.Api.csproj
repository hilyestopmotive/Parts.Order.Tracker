<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>parts-order-tracker-api-workshop</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<!-- API Description needed for OpenAPI => Swagger -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
		<!-- Entra ID and token authentication -->
		<PackageReference Include="Microsoft.Identity.Web" Version="4.0.1" />
		<!-- MongoDB queries -->
		<PackageReference Include="MongoDB.Driver" Version="3.12.0" />
		<!-- Swagger UI -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
	</ItemGroup>

</Project>
